# JWT Authentication Secret
JWT_SECRET=super-secret-key-change-this-for-production

# College Email Domains (Comma separated allowed domains)
COLLEGE_EMAIL_DOMAINS=college.edu,ac.in,edu.in,edu

# --- Supabase Database Configuration (Free Tier) ---
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Brevo (Sendinblue) Email OTP Service (Free Tier) ---
# Find this in Brevo Dashboard -> Transactional -> API Keys
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=your-verified-email@domain.com
BREVO_SENDER_NAME=CampusFind AI
